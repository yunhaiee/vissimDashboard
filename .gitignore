# Secrets — never commit
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
backend/tests/.tmp_*
backend/tests/pytest-cache-files-*

# Node / Next.js
node_modules/
frontend/.next/
frontend/.next-dev-log
*.tsbuildinfo

# Runtime data (uploads, simulation outputs, licenses) and Vissim project data
# (config.py resolves both at repo root; regenerate demo data with backend/tools/make_demo_data.py)
runtime/
data/

# Client-confidential source data (TK/Dochak drops: Daejeon SIS signal + count data,
# Main Roads WA signal/travel-time/turning-movement data). NEVER commit — this is the
# client's data, not ours, and the repo is only private, not secret.
client-data/
*.zip
# The second PDF root services/rag_pdf.py scans. Whatever is dropped there gets
# indexed into the RAG corpus, and in practice that means a client guideline or
# manual — the same data client-data/ exists to keep out of the repo. The
# manifest that names titles/page offsets is text we DO want tracked.
# (the contents, not the directory itself -- git cannot re-include a file that
# sits inside an excluded directory, and the manifest has to stay tracked)
docs/pdf_knowledge/*
!docs/pdf_knowledge/rag-manifest.json

# AI-tool session caches
.omc/
.codex/
.vercel/

# OS
Thumbs.db
.DS_Store
docs/_findings_compact.json
.superpowers/
