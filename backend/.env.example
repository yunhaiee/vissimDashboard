# Prism backend environment. Copy this file to backend/.env and fill it in.
# backend/.env is git-ignored -- never commit it, never paste it into chat.
# 이 파일을 backend/.env 로 복사한 뒤 값을 채우세요. .env 는 커밋 금지입니다.

# REQUIRED for the AI assistant / agent (Claude). Without it every non-AI
# screen still works; the assistant only reports "no provider".
# AI 어시스턴트·에이전트에 필요합니다. 없으면 AI 기능만 꺼지고 나머지는 동작합니다.
ANTHROPIC_API_KEY=

# Do not try to start a local Qwen worker at boot (demo boxes have no local model).
# 데모 PC에는 로컬 Qwen 모델이 없으므로 기동 시 워커를 띄우지 않습니다.
QWEN_WORKER_AUTO_START=0

# ---- optional overrides (uncomment to use) ---------------------------------

# Claude model for the assistant. Default: claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5

# Folder holding practice.inpx / Scenarios / real_counts.xlsx.
# Default: <repo>/data  (create it with:  python backend/tools/make_demo_data.py)
# VISSIM_DATA_DIR=

# Force one specific .inpx for simulation runs instead of the project's active dataset.
# VISSIM_SIMULATION_INPX_PATH=

# Observed-counts workbook. Default: <VISSIM_DATA_DIR>/real_counts.xlsx
# VISSIM_REAL_COUNTS_EXCEL=

# Extra browser origins allowed to call the API (comma-separated).
# http://localhost:3000 and http://127.0.0.1:3000 are always allowed.
# CORS_ORIGINS=
