# Copy to deploy/.env on the server and fill in. NEVER commit the filled copy —
# .gitignore blocks .env* at the repo root; this directory is covered by the
# same rule, and the values below are the whole security of the deployment.
#
#   cp deploy/env.example deploy/.env

# The hostname the A record points at. Caddy asks Let's Encrypt for this name,
# and the frontend image is BUILT against it (NEXT_PUBLIC_* is compile-time),
# so changing it means `docker compose build frontend` again, not just a restart.
PRISM_DOMAIN=prism.example.com

# The private wall in front of everything, including /api/*. Both must be
# non-empty or the gate is off (lib/demo-auth.ts: isDemoGateEnabled). This is
# the one shared key you hand to a viewer — it is NOT the product's named-user
# login, which is separate and lives in the app.
#
# Generate a password with:  python3 -c "import secrets; print(secrets.token_urlsafe(12))"
PRISM_DEMO_AUTH_USER=professor
PRISM_DEMO_AUTH_PASSWORD=

# Server-side only — never NEXT_PUBLIC_*, or it would be inlined into the
# client bundle and shipped to every viewer. Without it the assistant falls
# back rather than failing, so it is optional; with it, every viewer with the
# door key can spend it, so treat the password as spend authority.
ANTHROPIC_API_KEY=
