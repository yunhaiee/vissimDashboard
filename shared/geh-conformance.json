      "grade": "poor"
    },
    {
      "name": "model zero, observed positive",
      "model": 0,
      "observed": 100,
      "geh": 14.142135623730951,
      "grade": "poor"
    },
    {
      "name": "negative sum is undefined",
      "model": -50,
      "observed": -50,
      "geh": null,
      "grade": null
    },
    {
      "name": "negative model against a larger positive observed",
      "model": -20,
      "observed": 100,
      "geh": 18.973665961010276,
      "grade": "poor"
    },
    {
      "name": "null model",
      "model": null,
      "observed": 500,
      "geh": null,
      "grade": null
    },
    {
      "name": "null observed",
      "model": 500,
      "observed": null,
      "geh": null,
      "grade": null
    },
    {
      "name": "both null",
      "model": null,
      "observed": null,
      "geh": null,
      "grade": null
    },
    {
      "name": "large values (six figures) keep full double precision",
      "model": 987654,
      "observed": 123456,
      "geh": 1159.443864133695,
      "grade": "poor"
    },
    {
      "name": "fractional inputs - the digits where a rounded implementation would diverge",
      "model": 1234.5678,
      "observed": 1234.4321,
      "geh": 0.003862195996426809,
      "grade": "good"
    },
    {
      "name": "tiny total - a rounded-at-source implementation would report 0.0",
      "model": 0.3,
      "observed": 0.1,
      "geh": 0.44721359549995787,
      "grade": "good"
    },
    {
      "name": "NaN model is UNDEFINED, never a confident 'poor'",
      "model": "NaN",
      "observed": 100,
      "geh": null,
      "grade": null
    },
    {
      "name": "NaN observed is UNDEFINED, never a confident 'poor'",
      "model": 100,
