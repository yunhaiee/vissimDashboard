      "geh": null,
      "grade": null
    },
    {
      "name": "+Infinity model (an upstream divide-by-zero, e.g. volume scaling against a 0 count)",
      "model": "Infinity",
      "observed": 100,
      "geh": null,
      "grade": null
    },
    {
      "name": "+Infinity observed",
      "model": 100,
